erDiagram
    RESTAURANTE ||--|| PROGRAMA_FIDELIDAD : configura
    RESTAURANTE ||--o{ CUENTA_FIDELIDAD : fideliza
    COMENSAL ||--o{ CUENTA_FIDELIDAD : posee
    CUENTA_FIDELIDAD ||--o{ MOVIMIENTO_PUNTOS : registra
    PAGO |o--o{ MOVIMIENTO_PUNTOS : acredita
    RESTAURANTE ||--o{ GRUPO_BENEFICIOS : organiza
    GRUPO_BENEFICIOS |o--o{ BENEFICIO : agrupa
    RESTAURANTE ||--o{ BENEFICIO : ofrece
    MENU |o--o{ BENEFICIO : promocion_de
    PAGO ||--o{ BENEFICIO_APLICADO : aplica
    BENEFICIO ||--o{ BENEFICIO_APLICADO : aplicado_en
    SUCURSAL ||--|| CONFIGURACION_APERTURA : parametriza
    SUCURSAL ||--o{ PRONOSTICO : proyecta
    PRONOSTICO ||--o{ DEMANDA_ITEM : detalla
    ITEM_MENU ||--o{ DEMANDA_ITEM : estimado_en
    SUCURSAL ||--o{ ALERTA : recibe
    PRONOSTICO |o--o{ ALERTA : genera
    EXISTENCIA |o--o{ ALERTA : dispara
    ITEM_MENU |o--o{ ALERTA : dispara

    PROGRAMA_FIDELIDAD {
        uuid id PK
        uuid restaurante_id FK, UK
        numeric puntos_por_unidad
        bool activo
    }
    CUENTA_FIDELIDAD {
        uuid id PK
        uuid comensal_id FK
        uuid restaurante_id FK "UK con comensal_id"
        int puntos
        int visitas
        numeric monto_acumulado
    }
    MOVIMIENTO_PUNTOS {
        uuid id PK
        uuid cuenta_fidelidad_id FK
        uuid pago_id FK
        varchar tipo "ACREDITACION | CANJE | AJUSTE"
        int puntos
        timestamptz fecha
    }
    GRUPO_BENEFICIOS {
        uuid id PK
        uuid restaurante_id FK
        varchar nombre
        bool habilitado
    }
    BENEFICIO {
        uuid id PK
        uuid restaurante_id FK
        uuid grupo_id FK
        varchar clase "RECOMPENSA | PROMOCION"
        uuid menu_id FK "solo PROMOCION"
        varchar criterio_tipo "VISITAS | MONTO | PUNTOS | NUEVO_CLIENTE"
        numeric criterio_valor
        varchar tipo_descuento "PORCENTAJE | MONTO_FIJO"
        numeric valor
        timestamptz vigencia_desde
        timestamptz vigencia_hasta
        int stock_disponible
        bool activo
    }
    BENEFICIO_APLICADO {
        uuid pago_id PK, FK
        uuid beneficio_id PK, FK
        numeric monto_descontado
    }
    CONFIGURACION_APERTURA {
        uuid sucursal_id PK, FK
        int dias_historico_minimo
        numeric cubiertos_por_mozo
        numeric platos_por_cocinero_hora
        varchar metodo_pronostico
    }
    PRONOSTICO {
        uuid id PK
        uuid sucursal_id FK
        date fecha_servicio
        varchar franja
        int cubiertos_estimados
        int limite_inferior
        int limite_superior
        numeric error_mape
        varchar metodo
        timestamptz generado_en
    }
    DEMANDA_ITEM {
        uuid pronostico_id PK, FK
        uuid item_menu_id PK, FK
        int cantidad_estimada
    }
    ALERTA {
        uuid id PK
        uuid sucursal_id FK
        uuid pronostico_id FK
        uuid existencia_id FK
        uuid item_menu_id FK
        varchar tipo
        varchar severidad
        text descripcion
        timestamptz creada_en
        bool resuelta
    }
    RESTAURANTE {
        uuid id PK
    }
    SUCURSAL {
        uuid id PK
    }
    COMENSAL {
        uuid usuario_id PK
    }
    PAGO {
        uuid id PK
    }
    MENU {
        uuid id PK
    }
    ITEM_MENU {
        uuid id PK
    }
    EXISTENCIA {
        uuid id PK
    }
