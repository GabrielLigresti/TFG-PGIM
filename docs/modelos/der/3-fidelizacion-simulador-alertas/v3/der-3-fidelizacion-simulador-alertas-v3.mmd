erDiagram
    RESTAURANTE ||--|| PROGRAMA_FIDELIDAD : configura
    RESTAURANTE ||--o{ CUENTA_FIDELIDAD : fideliza
    COMENSAL ||--o{ CUENTA_FIDELIDAD : posee
    CUENTA_FIDELIDAD ||--o{ MOVIMIENTO_PUNTOS : registra
    CUENTA_FIDELIDAD ||--o{ VISITA : acumula
    CUENTA_MESA ||--o{ VISITA : origina
    PAGO |o--o{ MOVIMIENTO_PUNTOS : acredita
    RESTAURANTE ||--o{ GRUPO_BENEFICIOS : organiza
    GRUPO_BENEFICIOS |o--o{ BENEFICIO : agrupa
    RESTAURANTE ||--o{ BENEFICIO : ofrece
    MENU |o--o{ BENEFICIO : promocion_de
    PAGO ||--o{ BENEFICIO_APLICADO : aplica
    BENEFICIO ||--o{ BENEFICIO_APLICADO : aplicado_en
    SUCURSAL ||--|| CONFIGURACION_APERTURA : parametriza
    SUCURSAL ||--o{ PRONOSTICO : proyecta
    PRONOSTICO ||--o{ DEMANDA_ITEM : detalla
    ITEM_MENU ||--o{ DEMANDA_ITEM : estimado_en
    SUCURSAL ||--o{ PLANIFICACION_TURNOS : planifica
    PLANIFICACION_TURNOS ||--o{ TURNO : contiene
    PLANIFICACION_TURNOS |o--o{ ALERTA : reporta_faltante
    SUCURSAL ||--o{ ALERTA : recibe
    PRONOSTICO |o--o{ ALERTA : genera
    EXISTENCIA |o--o{ ALERTA : dispara
    ITEM_MENU |o--o{ ALERTA : dispara

    PROGRAMA_FIDELIDAD {
        uuid id PK
        uuid restaurante_id FK, UK
        numeric puntos_por_unidad
        bool activo
    }
    CUENTA_FIDELIDAD {
        uuid id PK
        uuid comensal_id FK
        uuid restaurante_id FK "UK con comensal_id"
        int puntos "nunca negativo"
        int cantidad_visitas
        numeric monto_acumulado
    }
    VISITA {
        uuid id PK
        uuid cuenta_fidelidad_id FK
        uuid cuenta_mesa_id FK "UK con cuenta_fidelidad_id"
        timestamptz fecha
    }
    MOVIMIENTO_PUNTOS {
        uuid id PK
        uuid cuenta_fidelidad_id FK
        uuid pago_id FK "null en AJUSTE"
        TipoMovimientoPuntos tipo "ACREDITACION | CANJE | AJUSTE"
        int puntos
        timestamptz fecha
    }
    GRUPO_BENEFICIOS {
        uuid id PK
        uuid restaurante_id FK
        varchar nombre
        bool habilitado
    }
    BENEFICIO {
        uuid id PK
        uuid restaurante_id FK
        uuid grupo_id FK "null si no esta agrupado"
        varchar nombre
        ClaseBeneficio clase "RECOMPENSA | PROMOCION"
        uuid menu_id FK "solo PROMOCION, obligatorio en ella"
        TipoCriterio criterio_tipo "solo RECOMPENSA, obligatorio en ella; VISITAS | MONTO | PUNTOS | NUEVO_CLIENTE"
        numeric criterio_valor "solo RECOMPENSA, obligatorio en ella; parametro del criterio (Strategy)"
        TipoDescuento tipo_descuento "PORCENTAJE | MONTO_FIJO"
        numeric valor
        timestamptz vigencia_desde "null si no tiene limite"
        timestamptz vigencia_hasta "null si no tiene limite"
        int stock_disponible "null si no tiene limite; nunca negativo"
        bool activo
    }
    BENEFICIO_APLICADO {
        uuid pago_id PK, FK "se registra con el pago PENDIENTE; vale solo si el pago queda APROBADO"
        uuid beneficio_id PK, FK
        numeric monto_descontado
    }
    CONFIGURACION_APERTURA {
        uuid sucursal_id PK, FK
        int semanas_historico_minimo "default 8"
        numeric cubiertos_por_mozo
        numeric platos_por_cocinero_hora
    }
    PLANIFICACION_TURNOS {
        uuid id PK
        uuid sucursal_id FK
        date semana_desde "UK con sucursal_id"
        EstadoPlanificacion estado "BORRADOR | CONFIRMADA"
        timestamptz generada_en
        timestamptz confirmada_en "solo CONFIRMADA"
    }
    PRONOSTICO {
        uuid id PK
        uuid sucursal_id FK
        date fecha_servicio
        FranjaServicio franja "ALMUERZO | CENA"
        int cubiertos_estimados
        int limite_inferior
        int limite_superior
        numeric ingreso_estimado
        numeric error_mape
        MetodoPronostico metodo "PROMEDIO_MOVIL_PONDERADO | NAIVE_ESTACIONAL | REGRESION_ESTACIONAL"
        timestamptz generado_en
    }
    DEMANDA_ITEM {
        uuid pronostico_id PK, FK
        uuid item_menu_id PK, FK
        int cantidad_estimada
    }
    ALERTA {
        uuid id PK
        uuid sucursal_id FK
        uuid pronostico_id FK "null si no la genera un pronostico"
        uuid planificacion_id FK "solo FALTANTE_PERSONAL"
        uuid existencia_id FK "null si no aplica al tipo"
        uuid item_menu_id FK "null si no aplica al tipo"
        TipoAlerta tipo "PLATO_SIN_RECETA | STOCK_INSUFICIENTE | FALTANTE_STOCK_PREVISTO | FALTANTE_PERSONAL | CAPACIDAD_MESAS"
        Severidad severidad "INFO | ADVERTENCIA | CRITICA"
        text descripcion
        date fecha_servicio "null si no aplica al tipo"
        FranjaServicio franja "ALMUERZO | CENA; null si no aplica al tipo"
        Arquetipo arquetipo "solo FALTANTE_PERSONAL"
        int cantidad "null si no aplica al tipo"
        timestamptz creada_en
        bool resuelta
    }
    RESTAURANTE {
        uuid id PK
    }
    SUCURSAL {
        uuid id PK
    }
    COMENSAL {
        uuid usuario_id PK
    }
    PAGO {
        uuid id PK
    }
    CUENTA_MESA {
        uuid id PK
    }
    MENU {
        uuid id PK
    }
    ITEM_MENU {
        uuid id PK
    }
    EXISTENCIA {
        uuid id PK
    }
    TURNO {
        uuid id PK
    }
