@startuml act-2-consumo-y-pago-en-la-mesa-v1-parte2
' Diagrama de actividades, formato Vialia (sin carriles; el actor va en el texto).
' Dividido en partes para el documento; los conectores (A), (B)... unen las partes.
skinparam dpi 220
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #000000
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #000000
  StartColor #000000
  EndColor #000000
}
skinparam circledCharacter {
  FontSize 12
}

(B)
if (¿Quiere pagar?) then (Sí)
  :Elegir monto y beneficios;
  repeat
    :Sistema: calcula el saldo y valida los beneficios;
    :Mercado Pago: procesa el cobro;
  repeat while (¿Pago aprobado?) is (No: pago nuevo) not (Sí)
  :Sistema: acredita puntos y monto,
  aplica el canje y emite el comprobante;
else (No)
endif
if (¿Sigue en la mesa?) then (Sí)
  (A)
  detach
else (No)
  (C)
  detach
endif
@enduml
