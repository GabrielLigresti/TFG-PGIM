@startuml act-4-gestion-de-stock-v1
' Diagrama de actividades, formato Vialia: sin carriles (el actor va en el texto),
' acciones blancas con borde negro, decisiones Sí/No. El marco se agrega al exportar.
skinparam dpi 220
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #000000
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #000000
  StartColor #000000
  EndColor #000000
}

start
if (¿Qué tarea realiza?) then (Configurar receta)
  :Jefe de cocina: elige el plato
  o el producto intermedio;
  repeat
    :Agregar línea: componente, cantidad,
    unidad y merma esperada;
    if (¿La unidad es de la misma dimensión?) then (No)
      :Sistema: rechaza la línea;
    else (Sí)
      if (¿El componente genera un ciclo?) then (Sí)
        :Sistema: rechaza la línea;
      else (No)
        :Sistema: agrega la línea;
      endif
    endif
  repeat while (¿Agrega otra línea?) is (Sí) not (No)
  :Sistema: guarda la receta y calcula el costo;
elseif (¿Qué tarea realiza?) then (Registrar movimiento)
  :Elegir tipo: ingreso, merma o ajuste;
  :Cargar el insumo o intermedio con stock,
  cantidad, unidad y motivo (la merma,
  con un motivo de la lista);
  if (¿La unidad es de la misma dimensión?) then (No)
    :Sistema: rechaza el movimiento;
    stop
  else (Sí)
  endif
  if (¿El stock quedaría negativo?) then (Sí)
    :Sistema: rechaza el movimiento;
    stop
  else (No)
  endif
  :Sistema: registra el movimiento con empleado
  y costo, y actualiza la existencia;
else (Registrar producción)
  :Elegir el intermedio con stock
  y la cantidad a producir;
  :Sistema: precarga los consumos teóricos
  según la receta;
  :Corregir lo usado y cargar
  la cantidad obtenida;
  if (¿Algún componente quedaría negativo?) then (Sí)
    :Sistema: rechaza la tanda completa;
    stop
  else (No)
  endif
  :Sistema: descuenta lo usado, suma lo obtenido,
  actualiza el costo del intermedio
  y muestra el rendimiento y el desvío;
endif
stop
@enduml
