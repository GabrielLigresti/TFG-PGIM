@startuml act-1-reservar-mesa-v1-parte3
' Diagrama de actividades, formato Vialia (sin carriles; el actor va en el texto).
' Dividido en partes para el documento; los conectores (A), (B)... unen las partes.
skinparam dpi 220
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #000000
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #000000
  StartColor #000000
  EndColor #000000
}
skinparam circledCharacter {
  FontSize 12
}

(B)
if (¿Cancela antes del inicio de la franja?) then (Sí)
  :Cancelar la reserva;
  :Sistema: libera la mesa;
  stop
else (No)
endif
if (¿Llega dentro de la tolerancia?) then (No)
  :Sistema: vence la reserva y libera la mesa;
  stop
else (Sí)
endif
:Iniciar flujo "Consumo y pago en la mesa";
stop
@enduml
