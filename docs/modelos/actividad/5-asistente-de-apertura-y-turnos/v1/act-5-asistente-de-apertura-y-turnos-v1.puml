@startuml act-5-asistente-de-apertura-y-turnos-v1
' Diagrama de actividades, formato Vialia: sin carriles (el actor va en el texto),
' acciones blancas con borde negro, decisiones Sí/No. El marco se agrega al exportar.
skinparam dpi 220
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #000000
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #000000
  StartColor #000000
  EndColor #000000
}

start
:Gerente: abre el asistente de apertura;
if (¿Hay al menos 8 semanas de historial?) then (No)
  :Sistema: muestra el progreso de datos;
  stop
else (Sí)
endif
:Sistema: pronostica cubiertos y platos por franja
con 3 métodos y elige el de menor error;
:Sistema: verifica stock y capacidad de mesas;
if (¿Hay faltantes previstos?) then (Sí)
  :Sistema: genera alertas;
else (No)
endif
repeat
  :Sistema: planifica los turnos de la semana
  (borrador);
  if (¿Falta personal?) then (Sí)
    :Sistema: genera alerta de faltante de personal;
  else (No)
  endif
  :Gerente: revisa la planificación;
repeat while (¿Regenera con otros parámetros?) is (Sí) not (No)
:Gerente: confirma la planificación;
:Sistema: publica los turnos al staff;
stop
@enduml
