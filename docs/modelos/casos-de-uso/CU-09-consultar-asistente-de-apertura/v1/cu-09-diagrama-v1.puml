@startuml cu-09-diagrama-v1
' Formato Vialia: actor de palitos, límite del sistema con pestaña "Sistema",
' casos de uso en elipses celestes sin número, «include»/«extend» punteados.
left to right direction
skinparam dpi 300
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam shadowing false
skinparam actorStyle default
skinparam packageStyle folder
skinparam nodesep 40
skinparam ranksep 70
skinparam actor {
  BorderColor #000000
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
  ArrowColor #000000
}
skinparam package {
  BorderColor #000000
  BorderThickness 3
  FontSize 22
  FontStyle plain
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #4A90D9
  BorderThickness 1
}
rectangle " " as MARCO {
  actor "Gerente de\nsucursal" as A1
  actor "Staff" as B1
  package "Sistema" {
    usecase "Consultar asistente\nde apertura" as P
    usecase "Pronosticar demanda" as I1
    usecase "Verificar stock\ny mesas" as I2
    usecase "Planificar turnos" as I3
  }
  A1 -- P
  B1 -- P
  P ..> I1 : <<include>>
  P ..> I2 : <<include>>
  P ..> I3 : <<include>>
  I3 -[hidden]> I2
  I2 -[hidden]> I1
}
@enduml
