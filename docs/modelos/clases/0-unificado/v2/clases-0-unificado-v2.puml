Pago "1" -- "0..1" Comprobante
Comensal "1" *-- "*" MedioPagoGuardado

' Relaciones — State
Reserva "*" --> "1" EstadoReserva : estado
EstadoReserva <|-- ReservaPendiente
EstadoReserva <|-- ReservaActiva
EstadoReserva <|-- ReservaFinalizada
EstadoReserva <|-- ReservaCancelada
EstadoReserva <|-- ReservaVencida
Pedido "*" --> "1" EstadoPedido : estado
EstadoPedido <|-- PedidoConfirmado
EstadoPedido <|-- PedidoEnPreparacion
EstadoPedido <|-- PedidoListo
EstadoPedido <|-- PedidoEntregado
EstadoPedido <|-- PedidoCancelado
