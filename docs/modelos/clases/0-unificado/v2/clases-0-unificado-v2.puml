@startuml clases-0-unificado-v2
' Diagrama de clases unificado — PGIM
' v2 (30/09): gaps GU-01 a GU-07 y patrón State en Reserva, Pedido y Pago (decisión D4). Formato de referencia: Vialia.
' Menor (05/10): alineación con el DER (informe GD-01 a GD-13): Reserva/Pedido -> Sucursal, Empleado.fotoUrl, EventoDominio no persistido, nota de criterio, sin asociación duplicada Empleado-Turno.
' Menor (05/10, b): operaciones que piden las especificaciones CU-01 a CU-10 para las secuencias (verificarFirma, buscarMesaDisponible, ingresar/ajustar, calcularDescuento/consumirStock, esElegible con desde, pronóstico por franja, faltantes de personal, PLANIFICACION_CONFIRMADA).
' Menor (05/10, c): consultas por asociación usadas en las secuencias (obtenerRol, obtenerSucursales, obtenerPermisos, obtenerRoles, obtenerReceta, obtenerModeloRA) y Permiso.listarPorModulo() (static, CU-02).
' PNG a 110 dpi (antes 125) para no superar 25 MP (límite de imágenes de Google Docs). Para imprimir o hacer zoom, usar el PDF/SVG vectorial.
top to bottom direction
skinparam dpi 110
skinparam defaultFontName Calibri
skinparam defaultFontSize 11
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 22
skinparam ranksep 38
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle
hide empty members

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3A3A3A
  ArrowColor #3A3A3A
  FontStyle bold
  HeaderBackgroundColor #B4B7F0
  HeaderBackgroundColor<<abstract>> #B4B7F0
  HeaderBackgroundColor<<interface>> #F6E3A6
  HeaderBackgroundColor<<service>> #EBA3A3
  HeaderBackgroundColor<<scheduled>> #EBA3A3
  HeaderBackgroundColor<<builder>> #EBA3A3
  HeaderBackgroundColor<<value object>> #D9D9D9
  HeaderBackgroundColor<<enum>> #FFFFFF
  StereotypeFontSize 9
}
skinparam package {
  BorderColor #8C8C8C
  FontColor #2E5E8C
  FontSize 13
  BackgroundColor #FFFFFF
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #999999
  FontSize 9
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #8C8C8C
  FontSize 10
}

' =====================================================================
package "1. Organización, acceso y personal" as P1 {
  class Restaurante {
    -nombre : String
    -cuit : String
    +obtenerRoles() : List<Rol>
  }
  class Sucursal {
    -nombre : String
    -direccion : String
    -horarioApertura : Time
    -horarioCierre : Time
    -toleranciaNoShowMin : Integer
    -activa : Boolean
    +buscarMesaDisponible(inicio : DateTime, personas : Integer) : Mesa
  }
  class HorarioServicio {
    -franja : FranjaServicio
    -horaInicio : Time
    -horaFin : Time
    +duracionHoras() : Decimal
  }
  abstract class Usuario <<abstract>> {
    -email : String
    -passwordHash : String
    -activo : Boolean
    +autenticar(credencial) : Boolean
  }
  class Empleado {
    -nombreCompleto : String
    -fotoUrl : String
    -horasSemanalesMax : Integer
    +puedeAcceder(permiso) : Boolean
    +arquetipo() : Arquetipo
    +obtenerRol() : Rol
    +obtenerSucursales() : List<Sucursal>
  }
  class Comensal {
    -nombre : String
    -telefono : String
  }
  class CredencialBiometrica {
    -credentialId : String
    -clavePublica : String
    -dispositivo : String
    -contadorFirmas : Integer
    +verificarFirma(desafio : String, firma : String) : Boolean
  }
  class Rol {
    -nombre : String
    -predeterminado : Boolean
    -arquetipo : Arquetipo
    -activo : Boolean
    +tienePermiso(permiso) : Boolean
    +obtenerPermisos() : List<Permiso>
  }
  class Permiso {
    -codigo : String
    -modulo : String
    -accion : String
    {static} +listarPorModulo() : Map<String, List<Permiso>>
  }
  class Turno {
    -fecha : Date
    -franja : FranjaServicio
    +horas() : Decimal
  }
}

