package "2. Salón, reservas, consumo y pago" as P2 {
  class Mesa {
    -numero : Integer
    -capacidad : Integer
    -posicionX : Decimal
    -posicionY : Decimal
    -activa : Boolean
    +estaDisponible(inicio : DateTime) : Boolean
  }
  class Reserva {
    -inicio : DateTime
    -cantidadPersonas : Integer
    -modoAsignacion : ModoAsignacion
    -estado : EstadoReserva
    +fin() : DateTime
    +activar() : void
    +cancelar() : void
    +vencer() : void
    +finalizar() : void
    ~cambiarEstado(nuevo : EstadoReserva) : void
  }
  class CuentaMesa {
    -abiertaEn : DateTime
    -cerradaEn : DateTime
    -estado : EstadoCuenta
    +total() : Decimal
    +saldoPendiente() : Decimal
    +estaAbierta() : Boolean
    +cerrar() : void
  }
  class Pedido {
    -numero : Integer
    -creadoEn : DateTime
    -estado : EstadoPedido
    -motivoCancelacion : String
    +avanzarEstado() : void
    +cancelar(motivo : String) : void
    ~cambiarEstado(nuevo : EstadoPedido) : void
  }
  class LineaPedido {
    -cantidad : Integer
    -precioUnitario : Decimal
    -observaciones : String
    +subtotal() : Decimal
  }
  class Pago {
    -monto : Decimal
    -metodo : MetodoPago
    -estado : EstadoPago
    -fecha : DateTime
    -referenciaExterna : String
    +aprobar() : void
    +rechazar() : void
    ~cambiarEstado(nuevo : EstadoPago) : void
  }
  class BeneficioAplicado {
    -montoDescontado : Decimal
  }
  class Comprobante {
    -numero : String
    -fechaEmision : DateTime
    -total : Decimal
  }
  class MedioPagoGuardado {
    -tokenPasarela : String
    -marca : String
    -ultimos4 : String
  }
}

' =====================================================================
package "Estados (patrón State)" as PS {
  abstract class EstadoReserva <<abstract>> {
    {abstract} +nombre() : String
    +activar(r : Reserva) : void
    +cancelar(r : Reserva) : void
    +vencer(r : Reserva) : void
    +finalizar(r : Reserva) : void
  }
  class ReservaPendiente {
    +activar(r : Reserva) : void
    +cancelar(r : Reserva) : void
    +vencer(r : Reserva) : void
  }
  class ReservaActiva {
    +finalizar(r : Reserva) : void
  }
  class ReservaFinalizada
  class ReservaCancelada
  class ReservaVencida

  abstract class EstadoPedido <<abstract>> {
    {abstract} +nombre() : String
    +avanzar(p : Pedido) : void
    +cancelar(p : Pedido, motivo : String) : void
  }
  class PedidoConfirmado {
    +avanzar(p : Pedido) : void
    +cancelar(p : Pedido, motivo : String) : void
  }
  class PedidoEnPreparacion {
    +avanzar(p : Pedido) : void
  }
  class PedidoListo {
    +avanzar(p : Pedido) : void
  }
  class PedidoEntregado
  class PedidoCancelado

  abstract class EstadoPago <<abstract>> {
    {abstract} +nombre() : String
    +aprobar(p : Pago) : void
    +rechazar(p : Pago) : void
  }
  class PagoPendiente {
    +aprobar(p : Pago) : void
    +rechazar(p : Pago) : void
  }
  class PagoAprobado
  class PagoRechazado
}

