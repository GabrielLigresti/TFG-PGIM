classDiagram
direction LR
class Sucursal
class Comensal
class ItemMenu
class CuentaFidelidad
class Alerta
class Mesa {
  +numero : Integer
  +capacidad : Integer
  +posicionX : Decimal
  +posicionY : Decimal
  +activa : Boolean
  +estaDisponible(inicio : DateTime) bool
}
class Reserva {
  +inicio : DateTime
  +fin() DateTime
  +cantidadPersonas : Integer
  +modoAsignacion : ModoAsignacion
  +estado : EstadoReserva
  +activar()
  +cancelar()
  +vencer()
}
class EstadoReserva {
  <<enumeration>>
  PENDIENTE
  ACTIVA
  FINALIZADA
  CANCELADA
  VENCIDA
}
class CuentaMesa {
  +abiertaEn : DateTime
  +cerradaEn : DateTime
  +estado : EstadoCuenta
  +total()
  +saldoPendiente()
  +cerrar()
}
class Pedido {
  +numero : Integer
  +creadoEn : DateTime
  +estado : EstadoPedido
  +avanzarEstado()
  +cancelar()
}
class EstadoPedido {
  <<enumeration>>
  CONFIRMADO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}
class LineaPedido {
  +cantidad : Integer
  +precioUnitario : Decimal
  +observaciones : String
  +subtotal()
}
class Pago {
  +monto : Decimal
  +metodo : MetodoPago
  +estado : EstadoPago
  +fecha : DateTime
  +referenciaExterna : String
}
class BeneficioAplicado {
  +montoDescontado : Decimal
}
class Comprobante {
  +numero : String
  +fechaEmision : DateTime
  +total : Decimal
}
class MedioPagoGuardado {
  +tokenPasarela : String
  +marca : String
  +ultimos4 : String
}
Sucursal "1" *-- "*" Mesa
Mesa "1" -- "*" Reserva
Comensal "1" -- "*" Reserva
Reserva "1" -- "0..1" CuentaMesa : se abre al activarse
CuentaMesa "1" *-- "*" Pedido
Pedido "1" *-- "1..*" LineaPedido
LineaPedido "*" --> "1" ItemMenu
CuentaMesa "1" -- "*" Pago
Comensal "1" -- "*" Pago
Pago "1" *-- "*" BeneficioAplicado
Pago "1" -- "0..1" Comprobante
Comensal "1" *-- "*" MedioPagoGuardado
class BusEventos {
  <<service>>
  +suscribir(tipoEvento, suscriptor)
  +publicar(evento)
}
class EventoDominio {
  +tipo : TipoEvento
  +sucursalId : UUID
  +comensalId : UUID
  +ocurridoEn : DateTime
  +datos : JSON
}
class Suscriptor {
  <<interface>>
  +manejar(evento)
}
class NotificadorSalon
class NotificadorStaff
class NotificadorComensal
class GeneradorAlertas
class RegistroVisitas
class CanalTiempoReal {
  <<service>>
  +emitir(canal, mensaje)
}
class TareaVencimientoReservas {
  <<scheduled>>
  +ejecutar()
}
Reserva ..> BusEventos : publica
Pedido ..> BusEventos : publica
Pago ..> BusEventos : publica
CuentaMesa ..> BusEventos : publica
BusEventos --> EventoDominio : distribuye
BusEventos "1" o-- "*" Suscriptor
Suscriptor <|.. NotificadorSalon
Suscriptor <|.. NotificadorStaff
Suscriptor <|.. NotificadorComensal
Suscriptor <|.. GeneradorAlertas
Suscriptor <|.. RegistroVisitas
NotificadorSalon --> CanalTiempoReal
NotificadorStaff --> CanalTiempoReal
NotificadorComensal --> CanalTiempoReal
GeneradorAlertas ..> Alerta : crea
RegistroVisitas ..> CuentaFidelidad : registrarVisita()
TareaVencimientoReservas ..> Reserva : vencer()
