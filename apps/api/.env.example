NODE_ENV=development
PORT=3000

# Coincide con docker-compose.yml (credenciales solo de desarrollo)
DATABASE_URL="postgresql://pgim:pgim@localhost:5432/pgim?schema=public"

# Clave para firmar los tokens de sesión (mínimo 32 caracteres).
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambiar-por-una-clave-de-al-menos-32-caracteres"

# Carpeta de los archivos subidos (modelos RA); por defecto, apps/api/uploads.
# UPLOADS_DIR=uploads

# Pago de prueba (aprueba al instante, sin cobrar). Siempre activo fuera de
# producción; con true también se habilita en producción, para una demo.
# PAGO_SIMULADO=false

# Mercado Pago, Checkout Pro con credenciales de prueba (solo en .env, nunca en
# el repo). Si falta alguna de las tres se usa el pago de prueba.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# PUBLIC_URL es la URL del túnel (npm run tunnel): cambia en cada arranque.
# PUBLIC_URL=
